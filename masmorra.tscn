[sub_resource type="Shader" id="FloorShader"]
code = "shader_type spatial;

varying vec2 floor_position;

void vertex() {
	floor_position = VERTEX.xz;
}

void fragment() {
	vec2 tile = floor(floor_position);
	float tone = fract(sin(dot(tile, vec2(12.9898, 78.233))) * 43758.5453);
	vec2 tile_edge = abs(fract(floor_position + 0.5) - 0.5);
	float edge = min(tile_edge.x, tile_edge.y);
	float width = max(length(fwidth(floor_position)), 0.001);
	float grout = 1.0 - smoothstep(0.016 - width, 0.016 + width, edge);
	vec3 stone = mix(vec3(0.25, 0.28, 0.32), vec3(0.39, 0.42, 0.46), tone);
	vec3 tiled = mix(stone, vec3(0.12, 0.14, 0.16), grout);
	vec2 marker_edge = abs(fract(floor_position / 5.0 + 0.5) - 0.5) * 5.0;
	float marker = 1.0 - smoothstep(0.045 - width, 0.045 + width, min(marker_edge.x, marker_edge.y));
	ALBEDO = mix(tiled, vec3(0.53, 0.39, 0.21), marker);
	ROUGHNESS = 0.9;
}
"

